# Build directories
build/
build-*/
builddir/
_superbuild/

# SDD plan workspaces (scratch, per-plan)
.superpowers/

# Local scratch (never commit)
.tmp_files/
downloads/

# IDE / editor state
.idea/
.vscode/
.zed/
.cache/
.clang-format.bak

# Android build state
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.cxx/
android/app/.cxx/

# Compiled artifacts — note: shaders/*.spv are DELIBERATELY committed
# (checked-in SPIR-V fallback when SDL_shadercross is unavailable).
*.o
*.a
*.so
*.apk

# SDL3 prefetch AARs (never vendored into the repo)
android/app/libs/

# Meson wrap artifacts: keep only .wrap files in the repo, ignore the
# extracted sources and the download cache (a build-time fetch, not vendoring)
subprojects/.wraplock
subprojects/packagecache/
subprojects/SDL3_ttf-*/

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees
